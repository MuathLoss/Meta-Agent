# Template for .env.production on the pilot server (spec v1.2, Section 14.1).
# Copy it, fill it in, then: chmod 600 .env.production. Never commit the real file.
# Every value here is a placeholder or a DEVELOPMENT/TEST value, not a commercial decision.

# --- Domain and TLS (Caddy gets the certificate automatically) ---
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# --- Secrets ---
# python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-64-random-hex-characters
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Encrypts channel credentials. Back it up OUTSIDE the database backups (spec Section 13).
TENANT_CHANNEL_SECRET_KEY=replace-with-generated-fernet-key
POSTGRES_USER=agent
POSTGRES_DB=agent
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-long-random-password

# --- Capacity knobs read today ---
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
WORKER_HEARTBEAT_SECONDS=60
# Change only if 172.29.10.0/24 clashes with a network on the server.
EDGE_SUBNET=172.29.10.0/24

# --- Product scope: fixed in docker-compose.prod.yml, listed here for reference ---
# ENABLED_CHANNELS=web_chat,whatsapp  BROADCASTS_ENABLED=false  OLLAMA_ENABLED=false
# The API refuses to start in production if broadcasts or Ollama are switched on.

# --- Reserved: read from Phase 2 (knowledge) and Phase 5 (entitlements) onward ---
# DEVELOPMENT/TEST PLACEHOLDERS from spec Section 12, not final commercial limits.
# GEMINI_API_KEY=
# CHAT_MODEL=gemini-2.5-flash-lite   # only if this key still has access; see spec Section 7.1
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# MONTHLY_WHATSAPP_OUTBOUND_LIMIT=1000   # keep at or below Meta's verified free service tier
# MONTHLY_WEB_MESSAGES_LIMIT=20000
# MAX_FILES_PER_TENANT=50
# MAX_FILE_SIZE_MB=10
# MAX_CRAWL_PAGES=20
# MONTHLY_LLM_SPEND_LIMIT_USD=15
